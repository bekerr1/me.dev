#!/usr/bin/env bash
# Refuse to commit anything that looks like a credential.
# Install with: git config core.hooksPath scripts

set -uo pipefail

# Provider key formats, plus generic assignments of a long opaque string.
patterns=(
  'sk-ant-api[0-9]{2}-[A-Za-z0-9_-]{20,}'
  'sk-[A-Za-z0-9]{32,}'
  'gh[pousr]_[A-Za-z0-9]{30,}'
  'AKIA[0-9A-Z]{16}'
  '-----BEGIN [A-Z ]*PRIVATE KEY-----'
  '(api[_-]?key|secret|token|password)["'"'"']?\s*[:=]\s*["'"'"'][A-Za-z0-9/+_-]{24,}'
)

found=0
while IFS= read -r file; do
  [[ -f $file ]] || continue
  for p in "${patterns[@]}"; do
    if git show ":$file" 2>/dev/null | grep -nEi -e "$p" >/dev/null; then
      printf 'possible credential in %s (pattern: %s)\n' "$file" "$p" >&2
      git show ":$file" | grep -nEi -e "$p" | head -3 | sed 's/^/    /' >&2
      found=1
    fi
  done
done < <(git diff --cached --name-only --diff-filter=ACM)

if [[ $found -eq 1 ]]; then
  cat >&2 <<'MSG'

Commit blocked. Move the value to ~/.config/me/secrets.env and read it from the
environment. If this is a false positive: git commit --no-verify
MSG
  exit 1
fi
