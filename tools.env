# Pinned versions for everything install.sh fetches from the network.
#
# Bump a pin here, re-run `me install`, and every machine converges on the same
# versions. `scripts/check-pins.sh` reports what has moved upstream.

# Matt Pocock's agent skills. Distributed as a Claude Code plugin and via the
# `skills` npm installer for every other harness.
#   https://github.com/mattpocock/skills
SKILLS_NPM_VERSION="1.5.23"
SKILLS_SOURCE="mattpocock/skills"

# firstmate -- agent swarm distro. It is a repo you clone and run a harness
# inside, not a config, so it is cloned to a fixed location and pinned by commit.
#   https://github.com/kunchenguid/firstmate
FIRSTMATE_REPO="https://github.com/kunchenguid/firstmate"
FIRSTMATE_REF="1231b6ae7fd4"
FIRSTMATE_HOME="${FIRSTMATE_HOME:-$HOME/.local/share/firstmate}"

# no-mistakes -- AI validation pipeline in front of `git push`.
# Installed from the release asset directly rather than through upstream's
# install.sh, which always takes releases/latest and can escalate to sudo.
#   https://github.com/kunchenguid/no-mistakes
NO_MISTAKES_VERSION="v1.53.0"

# treehouse -- "manage worktrees without managing worktrees". Same shape and
# same author as no-mistakes: a Go binary whose install.sh also ignores any pin
# and can escalate to sudo, so it is fetched the same direct way.
#   https://github.com/kunchenguid/treehouse
TREEHOUSE_VERSION="v2.3.0"

# Pi -- minimal, extensible agent harness. Ships a self-contained binary per
# platform (no Node needed), unlike its npm package and its curl|sh installer,
# which is interactive and installs Node first. Fetched from the release asset.
# Update by bumping this pin, not `pi update`.
#   https://github.com/earendil-works/pi
PI_VERSION="v1.4.0"

# pixi -- conda-forge package manager: user-wide tools via pixi/pixi-global.toml
# and per-project toolchains via each project's pixi.toml.
#   https://github.com/prefix-dev/pixi
PIXI_VERSION="v0.83.0"

# vscode-neovim -- runs the real nvim (and nvim/lua/me/config/vscode.lua) inside
# Cursor. Installed from Open VSX, Cursor's extension registry.
#   https://open-vsx.org/extension/asvetliakov/vscode-neovim
VSCODE_NEOVIM_VERSION="1.20.1"

# vscode-clangd -- C/C++ language server client for Cursor. Runs the clangd
# from packages.sh and reads compile_commands.json from the project.
#   https://open-vsx.org/extension/llvm-vs-code-extensions/vscode-clangd
VSCODE_CLANGD_VERSION="0.6.0"

# vscode-go -- Go language support for Cursor. Runs go and gopls from pixi.sh.
#   https://open-vsx.org/extension/golang/Go
VSCODE_GO_VERSION="0.58.0"

# rust-analyzer -- Rust support for Cursor. It is only the client: the server is
# rustup's rust-analyzer component, which matches the toolchain below. Not in
# `me pins`: Open VSX only carries the nightly 0.4.x pre-releases, while Cursor's
# own marketplace serves the stable 0.3.x line. To see the newest stable, run
# `cursor --install-extension rust-lang.rust-analyzer --force` and bump to it.
VSCODE_RUST_ANALYZER_VERSION="0.3.3097"

# Rust -- rustup itself, and the default toolchain it installs (install.d/rust.sh).
# Projects with a rust-toolchain.toml still get the toolchain they ask for.
#   https://github.com/rust-lang/rustup
RUSTUP_VERSION="1.29.2"
RUST_VERSION="1.99.1"

# lazy.nvim tracks its own `stable` branch; see nvim/lua/me/config/lazy.lua.

# tmux persistence. Pinned tags: neither plugin has changed since 2024 -- stable
# and very widely used rather than abandoned, but no reason to track master.
# Installed as plain clones, not via TPM, which needs an interactive prefix+I.
TMUX_PLUGIN_DIR="${TMUX_PLUGIN_DIR:-$HOME/.local/share/tmux/plugins}"
TMUX_RESURRECT_REPO="https://github.com/tmux-plugins/tmux-resurrect"
TMUX_RESURRECT_REF="v4.0.0"
TMUX_CONTINUUM_REPO="https://github.com/tmux-plugins/tmux-continuum"
TMUX_CONTINUUM_REF="v3.1.0"
